# =============================================================================
# MÔI TRƯỜNG DOCKER CONTAINER - HỆ THỐNG QUẢN LÝ CHẤM CÔNG TRƯỜNG ĐẠI HỌC
# =============================================================================
NODE_ENV=production
PORT=5000

# Kết nối MongoDB Replica Set trong mạng Docker Compose
MONGODB_URI=mongodb://mongo:27017/qlns_chamcong?replicaSet=rs0&directConnection=true

# Kết nối FastAPI Face Microservice
FACE_SERVICE_URL=http://face-service:8001

# Chuỗi bí mật mã hóa JWT (Bảo mật sản xuất)
JWT_SECRET=super_secret_jwt_key_daihoc_2026_datn_qlns_secure_production
JWT_REFRESH_SECRET=super_secret_refresh_key_daihoc_2026_datn_qlns_secure_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Danh sách nguồn truy cập CORS cho phép
CORS_WHITELIST=http://localhost:5000,http://localhost:3000,http://localhost:5173,https://chamcongdh.io.vn

# Cấu hình AI Gemini / Claude / DeepSeek (Tùy chọn)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LOCAL_LLM_URL=http://localhost:11434
