PORT=5000
NODE_ENV=development

# Cấu hình Kết nối Microsoft SQL Server (MSSQL)
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=DATN_QLNS_ChamCong_FaceRec
DB_USER=sa
DB_PASSWORD=your_sa_password_here
DB_INSTANCE=SQLEXPRESS
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Môi trường kiểm thử SQL Server
TEST_DB_NAME=DATN_QLNS_ChamCong_FaceRec_test
TEST_JWT_SECRET=replace_with_a_separate_random_test_secret_at_least_32_characters
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:5173
QR_SECRET=replace_with_an_optional_dedicated_random_qr_secret

# Cấu hình Gửi Email OTP (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Khóa bí mật thiết bị máy chấm công (Terminal Key)
TERMINAL_KEY=replace_with_a_random_terminal_key_at_least_32_characters
ATTENDANCE_EVIDENCE_DIR=D:\attendance-evidence
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_API_KEY=replace_with_a_random_internal_face_service_api_key

# Cấu hình Redis In-Memory & Distributed Cache
REDIS_URL=redis://localhost:6379

# Cấu hình MinIO / S3 Object Storage
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=datn-qlns-storage

# CORS Whitelist
CORS_WHITELIST=http://localhost:5173,http://localhost:3000
 
# Cấu hình AI Studio / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

